{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "build",
      "command": "cmake",
      "args": [
        "--build",
        "build",
        "--config",
        "${input:buildConfig}"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    }
  ],
  "inputs": [
    {
      "type": "pickString",
      "id": "buildConfig",
      "description": "Select build configuration",
      "options": [
        "Debug",
        "Release"
      ]
    }
  ]
}